# ====== BẮT BUỘC ======
# Mật khẩu đăng nhập của 2 người (đặt tuỳ ý, càng dài càng tốt)
USER1_PASSWORD=doi-mat-khau-nay
USER2_PASSWORD=doi-mat-khau-nay-nua
# Chuỗi bí mật ngẫu nhiên để ký cookie đăng nhập (>= 32 ký tự)
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# ====== TUỲ CHỌN ======
# Tên hiển thị mặc định (có thể đổi trong trang Cài đặt của app)
USER1_NAME=Anh
USER2_NAME=Em
# Ngôn ngữ chính của mỗi người: en (tiếng Anh) | zh (tiếng Trung)
USER1_LANG=en
USER2_LANG=zh

# ====== DATABASE (Upstash Redis qua Vercel Marketplace) ======
# Khi bấm "Connect" Upstash Redis trong Vercel, 2 biến này được tự thêm.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (hoặc) UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
